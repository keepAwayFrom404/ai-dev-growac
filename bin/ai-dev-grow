#!/usr/bin/env bash
set -euo pipefail

PROGRAM="ai-dev-grow"

fail() {
  echo "$PROGRAM: $*" >&2
  exit 1
}

resolve_script_path() {
  local source_path="$1"
  local source_dir link_target

  while [[ -L "$source_path" ]]; do
    source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
    link_target="$(readlink "$source_path")"
    if [[ "$link_target" = /* ]]; then
      source_path="$link_target"
    else
      source_path="$source_dir/$link_target"
    fi
  done

  source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
  echo "$source_dir/$(basename "$source_path")"
}

SCRIPT_PATH="$(resolve_script_path "${BASH_SOURCE[0]}")"
HUB_ROOT="$(cd -P "$(dirname "$SCRIPT_PATH")/.." && pwd)"
SKILL_SOURCE="$HUB_ROOT/.agents/skills/ai-dev-grow"
OPENCODE_TASK_SOURCE="$HUB_ROOT/.opencode/commands/task.md"
OPENCODE_ASSESS_SOURCE="$HUB_ROOT/.opencode/commands/assess.md"

usage() {
  cat <<'EOF'
Usage:
  ai-dev-grow install
  ai-dev-grow init [--id PROJECT_ID] [PROJECT_PATH]
  ai-dev-grow resolve [PROJECT_PATH]
  ai-dev-grow doctor [PROJECT_PATH]

Commands:
  install  Register the shared skill and CLI for the current user.
  init     Connect a Git repository to the central ai-dev-grow data.
  resolve  Print the current project and central data paths.
  doctor   Check installation, project configuration, and host support.
EOF
}

same_target() {
  local link_path="$1"
  local expected="$2"
  [[ -L "$link_path" ]] || return 1
  [[ "$(cd -P "$(dirname "$link_path")" && cd -P "$(dirname "$(readlink "$link_path")")" 2>/dev/null && pwd)/$(basename "$(readlink "$link_path")")" = "$expected" ]] 2>/dev/null
}

install_link() {
  local source_path="$1"
  local target_path="$2"
  local label="$3"

  mkdir -p "$(dirname "$target_path")"
  if [[ -e "$target_path" || -L "$target_path" ]]; then
    if same_target "$target_path" "$source_path"; then
      echo "$label already installed: $target_path"
      return
    fi
    fail "$label target already exists and was not created by this project: $target_path"
  fi

  ln -s "$source_path" "$target_path"
  echo "$label installed: $target_path -> $source_path"
}

check_link_target() {
  local source_path="$1"
  local target_path="$2"
  local label="$3"

  if [[ -e "$target_path" || -L "$target_path" ]]; then
    same_target "$target_path" "$source_path" || fail "$label target already exists and was not created by this project: $target_path"
  fi
}

command_install() {
  [[ -f "$SKILL_SOURCE/SKILL.md" ]] || fail "missing skill source: $SKILL_SOURCE/SKILL.md"
  [[ -f "$OPENCODE_TASK_SOURCE" ]] || fail "missing OpenCode task command: $OPENCODE_TASK_SOURCE"
  [[ -f "$OPENCODE_ASSESS_SOURCE" ]] || fail "missing OpenCode assess command: $OPENCODE_ASSESS_SOURCE"
  check_link_target "$SKILL_SOURCE" "$HOME/.agents/skills/ai-dev-grow" "skill"
  check_link_target "$SCRIPT_PATH" "$HOME/.local/bin/ai-dev-grow" "cli"
  check_link_target "$OPENCODE_TASK_SOURCE" "$HOME/.config/opencode/commands/task.md" "OpenCode /task command"
  check_link_target "$OPENCODE_ASSESS_SOURCE" "$HOME/.config/opencode/commands/assess.md" "OpenCode /assess command"
  install_link "$SKILL_SOURCE" "$HOME/.agents/skills/ai-dev-grow" "skill"
  install_link "$SCRIPT_PATH" "$HOME/.local/bin/ai-dev-grow" "cli"
  install_link "$OPENCODE_TASK_SOURCE" "$HOME/.config/opencode/commands/task.md" "OpenCode /task command"
  install_link "$OPENCODE_ASSESS_SOURCE" "$HOME/.config/opencode/commands/assess.md" "OpenCode /assess command"
  echo "installation complete"
}

git_root() {
  local project_path="$1"
  git -C "$project_path" rev-parse --show-toplevel 2>/dev/null || return 1
}

default_project_id() {
  local root_name="$1"
  local normalized
  normalized="$(echo "$root_name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9._-]+/-/g; s/^-+//; s/-+$//')"
  [[ -n "$normalized" ]] || return 1
  echo "$normalized"
}

validate_project_id() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9._-]{0,127}$ ]]
}

read_project_id() {
  local config_path="$1"
  sed -nE 's/^project_id:[[:space:]]*"([a-z0-9._-]+)"[[:space:]]*$/\1/p' "$config_path" | head -n 1
}

read_project_version() {
  local config_path="$1"
  sed -nE 's/^version:[[:space:]]*([0-9]+)[[:space:]]*$/\1/p' "$config_path" | head -n 1
}

validate_project_config() {
  local config_path="$1"
  [[ "$(read_project_version "$config_path")" = "1" ]] || return 1
  [[ -n "$(read_project_id "$config_path")" ]]
}

command_init() {
  local requested_id=""
  local project_path="."
  local path_set=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --id)
        [[ $# -ge 2 ]] || fail "--id requires a value"
        requested_id="$2"
        shift 2
        ;;
      -h|--help)
        usage
        return
        ;;
      -* ) fail "unknown init option: $1" ;;
      * )
        [[ "$path_set" -eq 0 ]] || fail "init accepts only one project path"
        project_path="$1"
        path_set=1
        shift
        ;;
    esac
  done

  local root config_dir config_path project_id existing_id temp_config
  root="$(git_root "$project_path")" || fail "not inside a Git repository: $project_path"
  config_dir="$root/.ai-dev-grow"
  config_path="$config_dir/project.yaml"
  project_id="$requested_id"
  if [[ -z "$project_id" ]]; then
    project_id="$(default_project_id "$(basename "$root")")" || fail "cannot derive project id; use --id"
  fi
  validate_project_id "$project_id" || fail "invalid project id: $project_id"

  if [[ -e "$config_path" ]]; then
    validate_project_config "$config_path" || fail "existing config is not recognized: $config_path"
    existing_id="$(read_project_id "$config_path")"
    [[ "$existing_id" = "$project_id" ]] || fail "project already initialized as '$existing_id'; refusing to overwrite with '$project_id'"
    echo "already initialized: $root ($existing_id)"
    return
  fi

  mkdir -p "$config_dir"
  temp_config="$(mktemp "$config_dir/.project.yaml.XXXXXX")"
  {
    echo 'version: 1'
    echo "project_id: \"$project_id\""
  } > "$temp_config"
  mv "$temp_config" "$config_path"
  echo "initialized: $root ($project_id)"
  echo "config: $config_path"
}

resolve_project() {
  local project_path="${1:-.}"
  local root config_path project_id
  root="$(git_root "$project_path")" || fail "not inside a Git repository: $project_path"
  config_path="$root/.ai-dev-grow/project.yaml"
  [[ -f "$config_path" ]] || fail "project is not initialized; run: ai-dev-grow init '$root'"
  validate_project_config "$config_path" || fail "invalid project config: $config_path"
  project_id="$(read_project_id "$config_path")"

  echo "project_root=$root"
  echo "project_id=$project_id"
  echo "hub_root=$HUB_ROOT"
  echo "graph_path=$HUB_ROOT/skills/graph.yaml"
  echo "task_command_path=$HUB_ROOT/commands/task.md"
  echo "assess_command_path=$HUB_ROOT/commands/assess.md"
  echo "evidence_dir=$HUB_ROOT/experiences"
}

command_doctor() {
  local project_path="${1:-.}"
  local failed=0

  [[ -f "$HUB_ROOT/skills/graph.yaml" ]] && echo "ok: central graph" || { echo "error: central graph missing" >&2; failed=1; }
  [[ -f "$SKILL_SOURCE/SKILL.md" ]] && echo "ok: shared skill source" || { echo "error: shared skill missing" >&2; failed=1; }
  same_target "$HOME/.agents/skills/ai-dev-grow" "$SKILL_SOURCE" && echo "ok: shared skill installed" || { echo "error: shared skill is not installed" >&2; failed=1; }
  same_target "$HOME/.local/bin/ai-dev-grow" "$SCRIPT_PATH" && echo "ok: CLI installed" || { echo "error: CLI is not installed" >&2; failed=1; }
  same_target "$HOME/.config/opencode/commands/task.md" "$OPENCODE_TASK_SOURCE" && echo "ok: OpenCode /task installed" || { echo "error: OpenCode /task is not installed" >&2; failed=1; }
  same_target "$HOME/.config/opencode/commands/assess.md" "$OPENCODE_ASSESS_SOURCE" && echo "ok: OpenCode /assess installed" || { echo "error: OpenCode /assess is not installed" >&2; failed=1; }
  command -v codex >/dev/null 2>&1 && echo "ok: Codex available" || echo "warning: Codex not found"
  command -v opencode >/dev/null 2>&1 && echo "ok: OpenCode available" || echo "warning: OpenCode not found"
  if resolve_project "$project_path" >/dev/null 2>&1; then
    echo "ok: project initialized"
  else
    echo "error: project is not initialized or config is invalid" >&2
    failed=1
  fi

  [[ "$failed" -eq 0 ]] || return 1
  echo "doctor: OK"
}

main() {
  local command="${1:-}"
  [[ -n "$command" ]] || { usage; exit 1; }
  shift || true

  case "$command" in
    install) [[ $# -eq 0 ]] || fail "install accepts no arguments"; command_install ;;
    init) command_init "$@" ;;
    resolve) [[ $# -le 1 ]] || fail "resolve accepts at most one project path"; resolve_project "${1:-.}" ;;
    doctor) [[ $# -le 1 ]] || fail "doctor accepts at most one project path"; command_doctor "${1:-.}" ;;
    -h|--help|help) usage ;;
    *) fail "unknown command: $command" ;;
  esac
}

main "$@"
